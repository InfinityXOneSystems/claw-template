{
  "name": "claw-autonomous-coding-system",
  "version": "1.0.0",
  "description": "Enterprise-grade autonomous coding system with AI capabilities",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest",
    "lint": "eslint .",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": [
    "autonomous",
    "coding",
    "ai",
    "enterprise",
    "full-stack"
  ],
  "author": "InfinityXOneSystems",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.3",
    "axios": "^1.6.2",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0",
    "rate-limit": "^2.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.55.0"
  }
}
